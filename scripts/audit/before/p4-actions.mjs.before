// Area 4: job actions and rename.
import { startServer, launch, open, json, snap, row, clean, JOBS, COPY, PORT } from './lib.mjs';

const srv = await startServer(COPY, PORT);
const browser = await launch();

function recorder(id, mode, store) {
  return [u => u.pathname.startsWith(`/api/jobs/${id}/`) && !u.pathname.endsWith('/result') && !u.pathname.includes('/abstraction') && !u.pathname.includes('/synthesis/status'), async (r) => {
    const req = r.request();
    if (req.method() !== 'POST') return r.fallback();
    store.push(`${req.method()} ${new URL(req.url()).pathname}`);
    await mode(r);
  }];
}

const cases = [
  ['partial: Retry failed -> 200', 'job_partial', 'Retry 4 failed', r => json(r, 200, { ok: true })],
  ['partial: Retry failed -> 409', 'job_partial', 'Retry 4 failed', r => json(r, 409, { error: 'Job is busy.' })],
  ['partial: Retry failed -> 500 HTML', 'job_partial', 'Retry 4 failed', r => r.fulfill({ status: 500, contentType: 'text/html', body: '<h1>bad gateway</h1>' })],
  ['partial: Retry failed -> abort', 'job_partial', 'Retry 4 failed', r => r.abort('connectionreset')],
  ['partial: Synthesize with warnings -> 200', 'job_partial', 'Synthesize with warnings', r => json(r, 200, { ok: true })],
  ['failed: Retry synthesis -> 200', 'job_failed', 'Retry synthesis', r => json(r, 200, { ok: true })],
  ['failed: Retry synthesis -> 500', 'job_failed', 'Retry synthesis', r => json(r, 500, { error: 'Worker unavailable' })],
  ['running: Cancel job -> 200', 'job_running', 'Cancel job', r => json(r, 200, { ok: true })],
  ['running: Cancel job -> 500', 'job_running', 'Cancel job', r => json(r, 500, { error: 'Cancel failed' })],
];
for (const [name, id, label, mode] of cases) {
  const posts = [];
  const { ctx, page, errors, dialogs } = await open(browser, {}, [recorder(id, mode, posts)]);
  await page.goto(srv.base + '#/job/' + id);
  await page.waitForSelector('#jobActions button');
  await page.getByRole('button', { name: label }).click();
  await page.waitForTimeout(1500);
  const s = await snap(page);
  const btnState = await page.evaluate(() => [...document.querySelectorAll('#jobActions button')].map(b => b.innerText + (b.disabled ? '(disabled)' : '')));
  const stored = await page.evaluate(() => (JSON.parse(localStorage.getItem('title-analyzer:recent-jobs:v1') || '[]')[0] || {}).status);
  row(name, `POSTs=${JSON.stringify(posts)} dialogs=${JSON.stringify(dialogs)} hash=${s.hash} buttons=${JSON.stringify(btnState)} recentJobStatus=${stored}`, 'one POST, visible outcome', posts.length === 1, clean(errors).slice(0, 2));
  await ctx.close();
}

{
  const posts = [];
  const { ctx, page, errors } = await open(browser, {}, [recorder('job_partial', async r => { await new Promise(x => setTimeout(x, 800)); json(r, 200, { ok: true }); }, posts)]);
  await page.goto(srv.base + '#/job/job_partial');
  await page.waitForSelector('#jobActions button');
  await page.getByRole('button', { name: 'Retry 4 failed' }).dblclick();
  await page.waitForTimeout(1500);
  row('double click Retry failed', `POSTs=${posts.length}`, '1 POST', posts.length === 1, clean(errors));
  await ctx.close();
}

{
  const posts = [];
  const { ctx, page, errors, dialogs } = await open(browser, {}, [recorder('job_partial', r => json(r, 200, { ok: true }), posts)]);
  await page.goto(srv.base + '#/job/job_partial');
  await page.waitForSelector('#jobActions button');
  const before = await page.evaluate(() => document.body.innerText.replace(/\s+/g, ' '));
  await page.getByRole('button', { name: 'Retry 4 failed' }).click();
  await page.waitForTimeout(2500);
  const after = await page.evaluate(() => document.body.innerText.replace(/\s+/g, ' '));
  row('Retry failed 200: any visible acknowledgement?', `pageTextChanged=${before !== after} dialogs=${dialogs.length}`, 'some confirmation that a retry started', before !== after || dialogs.length > 0, clean(errors), 'runJobAction 1816-1822: reloads the same unchanged job');
  await ctx.close();
}

{
  const posts = [];
  const { ctx, page, errors, dialogs } = await open(browser, {}, [recorder('job_running', r => json(r, 200, { ok: true }), posts)]);
  await page.goto(srv.base);
  await page.setInputFiles('#fileInput', [{ name: 'keep.txt', mimeType: 'text/plain', buffer: Buffer.from('x') }]);
  await page.waitForTimeout(800);
  const staged = await page.locator('#fileList .file-item').count();
  await page.evaluate(() => { location.hash = '#/job/job_running'; });
  await page.waitForSelector('#jobActions button');
  await page.getByRole('button', { name: 'Cancel job' }).click();
  await page.waitForTimeout(1200);
  const homeStaged = await page.locator('#fileList .file-item').count();
  const notice = await page.evaluate(() => document.getElementById('view-home').innerText.replace(/\s+/g, ' ').match(/cancel[^.]*\./i)?.[0] || '');
  row('Cancel job from job view', `staged before=${staged} after=${homeStaged} hash=${await page.evaluate(() => location.hash)} cancelNotice="${notice}" dialogs=${JSON.stringify(dialogs)}`, 'job shown as canceled; staged files on home untouched', homeStaged === staged && !!notice, clean(errors));
  await ctx.close();
}

const patchHandler = (store, mode) => [u => u.pathname === '/api/jobs/job_complete', async r => {
  const req = r.request();
  if (req.method() !== 'PATCH') return r.fallback();
  const body = JSON.parse(req.postData() || '{}');
  store.push(body);
  if (mode === 'ok') return json(r, 200, { job: { ...JOBS.job_complete.job, subjectTract: body.subjectTract } });
  if (mode === '409') return json(r, 409, { error: 'Name already used.' });
  if (mode === '500html') return r.fulfill({ status: 500, contentType: 'text/html', body: '<h1>x</h1>' });
  if (mode === 'abort') return r.abort('connectionreset');
}];
async function renameCase(name, mode, act, check) {
  const patches = [];
  const { ctx, page, errors, dialogs } = await open(browser, {}, [patchHandler(patches, mode)]);
  await page.goto(srv.base + '#/job/job_complete');
  await page.waitForSelector('#jobRenameBtn');
  await page.click('#jobRenameBtn');
  await act(page);
  await page.waitForTimeout(900);
  const st = await page.evaluate(() => ({
    editorOpen: !!document.getElementById('jobNameInput'),
    saveDisabled: document.getElementById('jobNameSaveBtn')?.disabled ?? null,
    title: (document.getElementById('jobTitleText')?.innerText || '').slice(0, 30),
    xss: window.__xss === 1,
    imgs: document.querySelectorAll('#jobHeader img').length,
    overflowX: document.documentElement.scrollWidth - innerWidth,
  }));
  const rc = JSON.parse(await page.evaluate(() => localStorage.getItem('title-analyzer:recent-jobs:v1') || '[]'));
  const v = check(st, patches, dialogs);
  row(name, `state=${JSON.stringify(st)} patches=${JSON.stringify(patches).slice(0, 70)} dialogs=${JSON.stringify(dialogs).slice(0, 60)} recent0="${(rc[0]?.tractDescription || '').slice(0, 25)}"`, v[1], v[0], clean(errors));
  await ctx.close();
}
await renameCase('rename: Cancel button', 'ok', p => p.click('#jobNameCancelBtn'), (s) => [!s.editorOpen, 'editor closes, old title back']);
await renameCase('rename: Escape key', 'ok', p => p.press('#jobNameInput', 'Escape'), (s) => [!s.editorOpen, 'editor closes']);
await renameCase('rename: Save valid name', 'ok', async p => { await p.fill('#jobNameInput', 'Renamed Tract A'); await p.click('#jobNameSaveBtn'); }, (s) => [!s.editorOpen && s.title === 'Renamed Tract A', 'editor closes, title = Renamed Tract A']);
await renameCase('rename: Save via Enter', 'ok', async p => { await p.fill('#jobNameInput', 'Renamed Tract B'); await p.press('#jobNameInput', 'Enter'); }, (s) => [!s.editorOpen && s.title === 'Renamed Tract B', 'editor closes, new title']);
await renameCase('rename: empty', 'ok', async p => { await p.fill('#jobNameInput', '   '); await p.click('#jobNameSaveBtn'); }, (s, pa, d) => [pa.length === 0 && d.length === 1, 'alert, no PATCH']);
await renameCase('rename: 500 chars', 'ok', async p => { await p.fill('#jobNameInput', 'W'.repeat(500)); await p.click('#jobNameSaveBtn'); }, (s) => [s.overflowX <= 0 && !s.editorOpen, 'no overflow, editor closed']);
await renameCase('rename: HTML name', 'ok', async p => { await p.fill('#jobNameInput', '"><img src=x onerror="window.__xss=1"> A&B'); await p.click('#jobNameSaveBtn'); }, (s) => [!s.xss && s.imgs === 0 && !s.editorOpen, 'escaped, editor closes']);
await renameCase('rename: PATCH 409', '409', async p => { await p.fill('#jobNameInput', 'Dup'); await p.click('#jobNameSaveBtn'); }, (s, pa, d) => [d.length === 1 && s.saveDisabled === false, 'alert, Save usable again']);
await renameCase('rename: PATCH 500 HTML', '500html', async p => { await p.fill('#jobNameInput', 'X'); await p.click('#jobNameSaveBtn'); }, (s, pa, d) => [d.length === 1 && s.saveDisabled === false, 'alert, Save usable again']);
await renameCase('rename: PATCH abort', 'abort', async p => { await p.fill('#jobNameInput', 'X'); await p.click('#jobNameSaveBtn'); }, (s, pa, d) => [d.length === 1 && s.saveDisabled === false, 'alert, Save usable again']);
await renameCase('rename: double Save click', 'ok', async p => { await p.fill('#jobNameInput', 'Twice'); await p.dblclick('#jobNameSaveBtn'); }, (s, pa) => [pa.length === 1, '1 PATCH']);
await browser.close();
srv.stop();

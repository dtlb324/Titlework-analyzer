// Area 6: Download PDF (CDN blocked and allowed) and Recent Jobs.
import fs from 'node:fs';
import { startServer, launch, open, json, snap, row, clean, JOBS, COPY, PORT, OUT } from './lib.mjs';

const srv = await startServer(COPY, PORT);
const browser = await launch();

// ---- PDF, CDN blocked
{
  const { ctx, page, errors, dialogs } = await open(browser);
  await page.goto(srv.base + '#/job/job_complete');
  await page.waitForSelector('#jobBarDownloadBtn', { state: 'visible' });
  let dl = null; page.once('download', d => { dl = d; });
  await page.click('#jobBarDownloadBtn');
  await page.waitForTimeout(800);
  row('PDF with CDN blocked (header button + bar button)', `download=${!!dl} dialogs=${JSON.stringify(dialogs)} jspdf=${await page.evaluate(() => typeof window.jspdf)}`, 'a visible message that PDF export is unavailable', !!dl || dialogs.length > 0, clean(errors).filter(e => /pageerror/.test(e)).slice(0, 2));
  await ctx.close();
}

// ---- PDF, CDN allowed
const big = (() => { const b = JOBS.job_complete.result.finalTitleOpinion; let s = b; while (s.length < 2_000_000) s += '\n\n' + b.replace(/^# /m, '## Appendix '); return s; })();
const pdfCases = [
  ['job_complete', 'job_complete', null],
  ['job_defect', 'job_defect', null],
  ['job_over', 'job_over', null],
  ['job_fallback (plain card)', 'job_fallback', null],
  ['job_partial', 'job_partial', null],
];
for (const [name, id, opinion] of pdfCases) {
  const over = opinion ? [[u => u.pathname === `/api/jobs/${id}/result`, r => json(r, 200, { result: { finalTitleOpinion: opinion, warnings: [], failedDocuments: [] } })]] : [];
  const { ctx, page, errors, dialogs } = await open(browser, { allowCdn: true }, over);
  await page.goto(srv.base + '#/job/' + id);
  await page.waitForSelector('#jobBarDownloadBtn', { state: 'visible', timeout: 60000 });
  await page.waitForFunction(() => window.jspdf, null, { timeout: 20000 }).catch(() => {});
  const t0 = Date.now();
  const [dl] = await Promise.all([page.waitForEvent('download', { timeout: 30000 }).catch(() => null), page.click('#jobBarDownloadBtn')]);
  let info = 'no download';
  if (dl) {
    const f = `${OUT}/pdf-${id}${opinion ? '-2mb' : ''}.pdf`;
    await dl.saveAs(f);
    info = `${dl.suggestedFilename()} ${fs.statSync(f).size}B in ${Date.now() - t0}ms`;
  }
  row('PDF ' + name, `${info} dialogs=${JSON.stringify(dialogs)}`, 'a non-empty file named after the tract', !!dl, clean(errors).slice(0, 2));
  await ctx.close();
}
// 2 MB opinion
{
  const over = [[u => u.pathname === '/api/jobs/job_complete/result', r => json(r, 200, { result: { finalTitleOpinion: big, warnings: [], failedDocuments: [] } })]];
  const { ctx, page, errors, dialogs } = await open(browser, { allowCdn: true }, over);
  await page.goto(srv.base + '#/job/job_complete');
  await page.waitForSelector('#jobBarDownloadBtn', { state: 'visible', timeout: 60000 });
  await page.waitForFunction(() => window.jspdf, null, { timeout: 20000 }).catch(() => {});
  const t0 = Date.now();
  const [dl] = await Promise.all([page.waitForEvent('download', { timeout: 150000 }).catch(() => null), page.click('#jobBarDownloadBtn')]);
  let info = 'no download within 150s';
  if (dl) { const f = `${OUT}/pdf-job_complete-2mb.pdf`; await dl.saveAs(f); info = `${fs.statSync(f).size}B in ${Date.now() - t0}ms`; }
  row('PDF 2MB opinion', `${info} dialogs=${JSON.stringify(dialogs)}`, 'completes in < 10s', !!dl && Date.now() - t0 < 10000, clean(errors).slice(0, 2));
  await ctx.close();
}

// ---- PDF button when the result is missing (result GET 404): visible header button, CDN allowed
{
  const { ctx, page, errors, dialogs } = await open(browser, { allowCdn: true }, [[u => u.pathname === '/api/jobs/job_complete/result', r => json(r, 404, { error: 'No result.' })]]);
  await page.goto(srv.base + '#/job/job_complete');
  await page.waitForSelector('#jobDownloadPdfBtn', { state: 'visible' });
  await page.waitForFunction(() => window.jspdf, null, { timeout: 20000 }).catch(() => {});
  const [dl] = await Promise.all([page.waitForEvent('download', { timeout: 3000 }).catch(() => null), page.click('#jobDownloadPdfBtn')]);
  await page.waitForTimeout(500);
  row('PDF button visible while result is missing', `download=${!!dl} dialogs=${JSON.stringify(dialogs)}`, 'button hidden/disabled, or a clear reason', false, clean(errors).slice(0, 2));
  await ctx.close();
}
// ---- Recent jobs
const KEY = 'title-analyzer:recent-jobs:v1';
const now = Date.now();
async function recent(name, seed, check, { init, hash = '#/jobs' } = {}) {
  const { ctx, page, errors } = await open(browser);
  if (init) await page.addInitScript(init);
  if (seed !== undefined) await page.addInitScript(([k, v]) => { try { localStorage.setItem(k, v); } catch {} }, [KEY, seed]);
  await page.goto(srv.base + hash);
  await page.waitForTimeout(900);
  const st = await page.evaluate(() => ({
    rows: document.querySelectorAll('#view-history .recent-jobs-row').length,
    text: document.getElementById('view-history').innerText.replace(/\s+/g, ' ').slice(0, 130),
    xss: window.__xss === 1, imgs: document.querySelectorAll('#view-history img').length,
    toolbar: document.getElementById('recentJobsButton')?.getAttribute('aria-disabled'),
    count: document.getElementById('recentJobsCount')?.innerText,
  }));
  const v = check(st);
  row(name, JSON.stringify(st), v[1], v[0], clean(errors).slice(0, 2));
  await ctx.close();
}
const mk = (i, extra = {}) => ({ id: `job_x${i}`, tractDescription: `Tract ${i}`, status: 'complete', documentCount: 3, lastViewedAt: now - i * 1000, ...extra });
await recent('recent: corrupt JSON', '{not json', s => [/No jobs/.test(s.text), 'empty state, no crash']);
await recent('recent: JSON is an object', '{"a":1}', s => [/No jobs/.test(s.text), 'empty state']);
await recent('recent: storage throws', undefined, s => [/No jobs/.test(s.text), 'empty state, no crash'], { init: () => { Object.defineProperty(window, 'localStorage', { get() { throw new DOMException('denied', 'SecurityError'); } }); } });
await recent('recent: 35 stored jobs', JSON.stringify(Array.from({ length: 35 }, (_, i) => mk(i))), s => [s.rows === 20, '20 rows max (limit 20)']);
await recent('recent: HTML in stored name', JSON.stringify([mk(1, { tractDescription: '<img src=x onerror="window.__xss=1">Tract & "Q"' })]), s => [!s.xss && s.imgs === 0 && /Tract &/.test(s.text), 'escaped text']);
await recent('recent: entry without lastViewedAt (older format)', JSON.stringify([{ id: 'job_complete', tractDescription: 'Old entry', status: 'complete', documentCount: 2 }]), s => [s.rows === 1, 'old entry still listed']);
await recent('recent: running job only -> toolbar', JSON.stringify([mk(1, { status: 'abstracting' })]), s => [s.rows === 1, 'listed'], { hash: '#/' });
await recent('recent: NaN documentCount', JSON.stringify([mk(1, { documentCount: 'abc' })]), s => [/0 documents/.test(s.text), 'tolerated']);
{
  const { ctx, page, errors } = await open(browser);
  await page.addInitScript(([k, v]) => localStorage.setItem(k, v), [KEY, JSON.stringify([mk(1, { id: 'job_gone', tractDescription: 'Deleted on server' })])]);
  await page.goto(srv.base + '#/jobs');
  await page.click('.recent-jobs-row');
  await page.waitForTimeout(1200);
  const s = await snap(page);
  await page.evaluate(() => { location.hash = '#/jobs'; });
  await page.waitForTimeout(500);
  const after = await page.evaluate(() => ({ rows: document.querySelectorAll('#view-history .recent-jobs-row').length, hasRemove: /remove|delete|clear/i.test(document.getElementById('view-history').innerText) }));
  row('recent: entry that now 404s', `header="${s.header.slice(0, 50)}" afterwards rows=${after.rows} removeControl=${after.hasRemove}`, 'entry removed or marked gone, with a way to clear', after.rows === 0 || after.hasRemove, clean(errors).slice(0, 1));
  await ctx.close();
}
{
  const { ctx, page, errors } = await open(browser);
  await page.addInitScript(([k, v]) => localStorage.setItem(k, v), [KEY, JSON.stringify([mk(1, { id: 'job_complete', status: 'abstracting', tractDescription: 'NW/4 stale' })])]);
  await page.goto(srv.base + '#/jobs');
  await page.waitForTimeout(800);
  const t = await page.evaluate(() => document.querySelector('#view-history .recent-jobs-row .status-badge')?.innerText);
  row('recent: list status vs server truth', `badge="${t}" (server says complete)`, 'list shows current status', !/process|abstract/i.test(t || ''), clean(errors).slice(0, 1));
  await ctx.close();
}
await browser.close();
srv.stop();

// Shared audit harness: local server.js + headless Chromium + mocked /api.
// Usage: import { startServer, launch, newPage, fileObjs, JOBS, measure } from '<abs>/harness.mjs'
import { spawn } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const PW = '<SCRATCH>/pr135-pixel/tools/node_modules/playwright-core/index.mjs';
const { chromium } = await import(PW);
export const EXE = `${process.env.HOME}/Library/Caches/ms-playwright/chromium_headless_shell-1248/chrome-headless-shell-mac-arm64/chrome-headless-shell`;

export const fixture = name => fs.readFileSync(path.join(HERE, 'fixtures', name), 'utf8');

// Starts `node server.js` from repoDir on port with a clean env (no .env.local, no keys).
export async function startServer(repoDir, port) {
  const child = spawn(process.execPath, ['server.js'], {
    cwd: repoDir,
    env: { PATH: process.env.PATH, HOME: process.env.HOME, PORT: String(port), NODE_ENV: 'test' },
    stdio: 'ignore',
  });
  const base = `http://127.0.0.1:${port}/`;
  for (let i = 0; i < 50; i++) {
    try { const r = await fetch(base + 'api/healthz'); if (r.ok) return { child, base, stop: () => child.kill() }; } catch {}
    await new Promise(r => setTimeout(r, 100));
  }
  child.kill();
  throw new Error(`server did not start on ${port}`);
}

// Default: headless Chromium shell. AUDIT_CHROME=real runs the same probe in the user's installed
// Google Chrome, headed, with a throwaway profile (their own profile and tabs are not touched).
export const REAL_CHROME = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';
export async function launch() {
  if (process.env.AUDIT_CHROME === 'real') return chromium.launch({ executablePath: REAL_CHROME, headless: false });
  return chromium.launch({ executablePath: EXE, headless: true });
}


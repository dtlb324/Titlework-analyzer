# Copy to .env.local and fill in. .env.local is gitignored; this file is placeholders only.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
GCS_BUCKET=your-bucket-name
APP_PASSWORD=pick-a-password
# Worker only. Required in production for POST /internal/drain.
# Send the same value as the X-Internal-Drain-Token header.
INTERNAL_DRAIN_TOKEN=pick-a-long-random-token
